# -------------------------------------------------------------------
#  Signet Hackathon Environment Variables
# 
#  Create a .env.local or .env file in the project root
#  and copy the contents of this file into it.
# 
#  Then, obtain your API keys from Google AI Studio:
#  https://aistudio.google.com/app/apikey
# -------------------------------------------------------------------

# [REQUIRED] Standard Gemini API Key
# Used for text-based chat and other standard HTTP API calls.
# IMPORTANT: This key MUST have "HTTP referrer" restrictions enabled
# for the domain your application is running on (e.g., localhost, your-app.vercel.app).
GEMINI_API_KEY="YOUR_STANDARD_API_KEY_HERE"

# [REQUIRED] Live Gemini API Key
# Used for the real-time, WebSocket-based voice chat.
# IMPORTANT: This key MUST be "Unrestricted" in the Google Cloud Console.
# It will not work for standard API calls.
GEMINI_LIVE_API_KEY="YOUR_LIVE_API_KEY_HERE"
